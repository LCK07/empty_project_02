<?xml version="1.0" encoding="utf-8"?>
<!-- Most Xtream servers are plain HTTP, and the server address is chosen by the owner. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
